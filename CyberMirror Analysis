<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <title>CyberMirror Analysis</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<div id="app"></div>

<script src="script.js"></script>

</body>
</html>body {
  margin: 0;
  font-family: Arial;
  background: #020617;
  color: white;
}

.container {
  max-width: 900px;
  margin: 0 auto;
  padding: 24px;
}

.title {
  font-size: 42px;
  margin-bottom: 10px;
}

.subtitle {
  color: #cbd5e1;
  margin-bottom: 30px;
}

.result-box {
  background: #0f172a;
  padding: 30px;
  border-radius: 16px;
  margin-bottom: 25px;
}

.score {
  font-size: 60px;
  font-weight: bold;
}

.profile {
  font-size: 22px;
  margin-top: 10px;
}

.bar {
  height: 12px;
  background: #1e293b;
  border-radius: 10px;
  overflow: hidden;
  margin: 12px 0;
}

.bar-fill {
  height: 12px;
  background: #22c55e;
}

.section {
  margin-top: 30px;
}

.section h2 {
  margin-bottom: 10px;
}

.recommendation {
  background: #1e293b;
  padding: 14px;
  border-radius: 10px;
  margin-bottom: 10px;
}function getParam(name) {
  const url = new URL(window.location.href);
  return url.searchParams.get(name);
}

const score = parseInt(getParam("score")) || 50;

function getProfile(score) {
  if (score >= 80) return "Świadomy użytkownik";
  if (score >= 60) return "Uważny, ale podatny na presję";
  if (score >= 40) return "Impulsywny klikacz";
  return "Wysokie ryzyko manipulacji";
}

function getRecommendations(score) {
  if (score >= 80) {
    return [
      "Zachowujesz ostrożność – to Twoja największa przewaga.",
      "Nie działasz pod presją czasu.",
      "Analizujesz zanim klikniesz."
    ];
  }

  if (score >= 60) {
    return [
      "Uważaj na sytuacje z presją czasu.",
      "Zatrzymaj się przed kliknięciem linku.",
      "Nie ufaj automatycznie wiadomościom."
    ];
  }

  if (score >= 40) {
    return [
      "Twoje decyzje są szybkie – to ryzyko.",
      "Zanim klikniesz, sprawdź źródło.",
      "Nie reaguj impulsywnie."
    ];
  }

  return [
    "Jesteś bardzo podatny na manipulację.",
    "Zawsze sprawdzaj nadawcę wiadomości.",
    "Nigdy nie działaj natychmiast pod presją."
  ];
}

function getBars(score) {
  return [
    { label: "Ostrożność", value: score },
    { label: "Podatność na presję", value: 100 - score },
    { label: "Refleksyjność", value: score - 10 }
  ];
}

function render() {
  const profile = getProfile(score);
  const recs = getRecommendations(score);
  const bars = getBars(score);

  document.getElementById("app").innerHTML = `
    <div class="container">

      <h1 class="title">CyberMirror Analysis ✦</h1>
      <p class="subtitle">
        To nie jest tylko wynik. To sposób, w jaki reagujesz w sytuacjach online.
      </p>

      <div class="result-box">
        <div class="score">${score}%</div>
        <div class="profile">${profile}</div>
      </div>

      <div class="section">
        <h2>Twoje zachowanie</h2>
        ${bars.map(b => `
          <div>
            <div>${b.label}</div>
            <div class="bar">
              <div class="bar-fill" style="width:${b.value}%"></div>
            </div>
          </div>
        `).join("")}
      </div>

      <div class="section">
        <h2>Co to oznacza</h2>
        ${recs.map(r => <div class="recommendation">${r}</div>).join("")}
      </div>

      <div class="section">
        <h2>Wnioski</h2>
        <p>
          Twoje decyzje w sieci nie zawsze wynikają z wiedzy,
          ale z reakcji na sytuację. To właśnie tam zaczyna się większość zagrożeń.
        </p>
      </div>

      <div class="section" style="margin-top:40px; font-size:14px; color:#94a3b8;">
        Autorka: Michalina Staszewska<br>
        klasa 2 LO<br>
        LO im. Adama Mickiewicza w Żychlinie
      </div>

    </div>
  `;
}

render();

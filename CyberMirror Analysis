    radial-gradient(circle at 50% 80%, rgba(255, 80, 0, 0.25), transparent 45%),
    linear-gradient(180deg, #1a0603 0%, #020617 100%);
  background-size: 200% 200%;
  animation: gradientMove 18s ease infinite;
  color: white;
}
